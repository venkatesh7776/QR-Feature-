# Cloudflare: records in D1, photos and voice notes in R2.
# Without these, data is kept locally in .data/ (fine for development).
CLOUDFLARE_ACCOUNT_ID=
# My Profile > API Tokens > Create token, with Account > D1 > Edit.
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
# R2 > Manage API tokens > Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=murali-varshitha-memories

# The couple's passcode for the albums, QR and delete pages (guests never need it).
COUPLE_PASSCODE=
# Secret used to sign the passcode cookie (any long random string).
SESSION_SECRET=

# Public URL that QR codes point to (e.g. your deployed site).
# SHARE_ORIGIN=https://your-site.com
