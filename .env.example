# Supabase (permanent storage). Without these, data is kept locally in .data/.
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API Keys → secret / service_role key. Server-only, never share.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: public URL that QR codes should point to (e.g. your deployed site).
# SHARE_ORIGIN=https://your-site.com

# Cloudflare R2 for photos and voice notes (records stay in Supabase). When all
# four are set, files go to R2; otherwise to Supabase Storage.
# R2 → Manage API tokens → Object Read & Write on this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=murali-varshitha-memories
