# Supabase (permanent storage). Without these, data is kept locally in .data/.
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API Keys → secret / service_role key. Server-only, never share.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: public URL that QR codes should point to (e.g. your deployed site).
# SHARE_ORIGIN=https://your-site.com
